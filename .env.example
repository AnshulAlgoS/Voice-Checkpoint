# Rime TTS (server only)
RIME_API_KEY=
RIME_ENDPOINT=https://users.rime.ai/v1/rime-tts
RIME_MODEL=coda
RIME_VOICE=celeste
RIME_LANGUAGE=en
RIME_AUDIO_FORMAT=mp3

# LiveKit room access (server only)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Used by the optional STT agent in voice_agent.py
LIVEKIT_AGENT_NAME=voice-checkpoint-transcriber
LIVEKIT_STT_MODEL=deepgram/nova-3-general
